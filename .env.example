# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas Cloud)
# Local: mongodb://localhost:27017/phishing_awareness
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/phishguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/phishing_awareness
HISTORY_TTL_DAYS=30

# LLM Configuration (Google Gemini Unified SDK - get from https://aistudio.google.com/)
# Set in .env locally, and under Environment Variables tab in Render dashboard
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Security & CORS
# In production, set to your Render deployment URL or *
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_chars
